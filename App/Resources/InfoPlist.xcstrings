{
  "sourceLanguage" : "en",
  "strings" : {
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy prompt when a watched folder is on the Desktop",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper v této složce sleduje nové soubory, aby mohl prošlé přesunout do Koše." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper beobachtet diesen Ordner auf neue Dateien, um abgelaufene in den Papierkorb zu legen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper supervisa esta carpeta para detectar archivos nuevos y mover los caducados a la Papelera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper surveille ce dossier pour détecter les nouveaux fichiers et mettre ceux qui ont expiré à la corbeille." } }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy prompt when a watched folder is in Documents",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper v této složce sleduje nové soubory, aby mohl prošlé přesunout do Koše." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper beobachtet diesen Ordner auf neue Dateien, um abgelaufene in den Papierkorb zu legen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper supervisa esta carpeta para detectar archivos nuevos y mover los caducados a la Papelera." } },
