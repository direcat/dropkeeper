    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Privacy prompt for the Downloads folder",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper v této složce sleduje nová stažení, aby mohl prošlá přesunout do Koše." } },
