    "That item is not a folder." : {
      "comment" : "Error when a dropped or chosen item is not a folder",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato položka není složka." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Objekt ist kein Ordner." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ese elemento no es una carpeta." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cet élément n’est pas un dossier." } }
      }
    },
    "That folder can't be watched." : {
      "comment" : "Error when a folder cannot be watched, e.g. the disk root",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tuto složku nelze sledovat." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Ordner kann nicht überwacht werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esa carpeta no se puede supervisar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce dossier ne peut pas être surveillé." } }
      }
    },
    "That folder is inside, or contains, a folder that is already watched." : {
      "comment" : "Error when a new folder overlaps a watched one",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato složka leží ve sledované složce, nebo sledovanou složku obsahuje." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Ordner liegt in einem überwachten Ordner oder enthält einen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta carpeta está dentro de una carpeta supervisada o contiene una." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce dossier se trouve dans un dossier surveillé ou en contient un." } }
      }
    },
    "%lld files could not be updated." : {
      "comment" : "Error after a batch action where some files failed",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld file could not be updated." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld files could not be updated." } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubor se nepodařilo upravit." } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubory se nepodařilo upravit." } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld souboru se nepodařilo upravit." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld souborů se nepodařilo upravit." } } } } },
        "de" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld Datei konnte nicht aktualisiert werden." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld Dateien konnten nicht aktualisiert werden." } } } } },
        "es" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo actualizar %lld archivo." } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron actualizar %lld archivos." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron actualizar %lld archivos." } } } } },
        "fr" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld fichier n’a pas pu être mis à jour." } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld fichiers n’ont pas pu être mis à jour." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld fichiers n’ont pas pu être mis à jour." } } } } }
      }
    },
    "Something went wrong. Please try again." : {
      "comment" : "Generic error message",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Něco se pokazilo. Zkuste to prosím znovu." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Etwas ist schiefgelaufen. Bitte erneut versuchen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Algo salió mal. Inténtalo de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une erreur s’est produite. Veuillez réessayer." } }
      }
    },
    "DropKeeper can't start" : {
      "comment" : "Fatal alert title when the engine fails to start",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper se nepodařilo spustit" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper kann nicht gestartet werden" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper no se puede iniciar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper ne peut pas démarrer" } }
      }
    },
    "Couldn't update the file. Please try again." : {
      "comment" : "Panel error after a failed prompt or list action",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo upravit. Zkuste to prosím znovu." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei konnte nicht aktualisiert werden. Bitte erneut versuchen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo actualizar el archivo. Inténtalo de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de mettre à jour le fichier. Veuillez réessayer." } }
      }
    },
    "Couldn't put the file back from the Trash." : {
      "comment" : "Panel error after a failed Undo",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo vrátit z Koše." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei konnte nicht aus dem Papierkorb zurückgelegt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo recuperar el archivo de la Papelera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de remettre le fichier depuis la corbeille." } }
      }
    },
    "Couldn't move the file to the Trash. Please try again later." : {
      "comment" : "Panel error after a failed Retry",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo přesunout do Koše. Zkuste to prosím později." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei konnte nicht in den Papierkorb gelegt werden. Bitte später erneut versuchen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo mover el archivo a la Papelera. Inténtalo de nuevo más tarde." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de mettre le fichier à la corbeille. Veuillez réessayer plus tard." } }
      }
    },
    "Couldn't watch Downloads" : {
      "comment" : "Onboarding alert title when adding Downloads fails",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složku Stažené nelze sledovat" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Downloads kann nicht überwacht werden" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo supervisar Descargas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de surveiller Téléchargements" } }
      }
    },
    "DropKeeper can't open its database" : {
      "comment" : "Fatal alert title at launch",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemůže otevřít svou databázi" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper kann seine Datenbank nicht öffnen" } },
