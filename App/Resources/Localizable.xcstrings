{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld days" : {
      "comment" : "Timeline stop in days, e.g. 1 day, 10 days",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld day" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld days" } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld den" } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld dny" } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld dne" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld dní" } } } } }
      }
    },
    "%lld h" : {
      "comment" : "Timeline stop in hours, e.g. 1 h",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld h" } } }
    },
    "%lld min" : {
      "comment" : "Timeline stop in minutes, e.g. 30 min",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } } }
    },
    "Today %@" : {
      "comment" : "Deletion time today, e.g. Today 16:40",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Dnes %@" } } }
    },
    "Tomorrow %@" : {
      "comment" : "Deletion time tomorrow, e.g. Tomorrow 09:15",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zítra %@" } } }
    },
    "in <1 min" : {
      "comment" : "Less than a minute left",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "za <1 min" } } }
    },
    "in %lld min" : {
      "comment" : "Minutes left, e.g. in 42 min",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "za %lld min" } } }
    },
    "in %lld h" : {
      "comment" : "Hours left, e.g. in 3 h",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "za %lld h" } } }
    },
    "in %lld days" : {
      "comment" : "Days left, e.g. in 2 days",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "in %lld day" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "in %lld days" } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "za %lld den" } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "za %lld dny" } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "za %lld dne" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "za %lld dní" } } } } }
      }
    },
    "That item is not a folder." : {
      "comment" : "Error when a dropped or chosen item is not a folder",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato položka není složka." } } }
    },
    "That folder can't be watched." : {
      "comment" : "Error when a folder cannot be watched, e.g. the disk root",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tuto složku nelze sledovat." } } }
    },
    "That folder is inside, or contains, a folder that is already watched." : {
      "comment" : "Error when a new folder overlaps a watched one",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato složka leží ve sledované složce, nebo sledovanou složku obsahuje." } } }
    },
    "%lld files could not be updated." : {
      "comment" : "Error after a batch action where some files failed",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld file could not be updated." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld files could not be updated." } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubor se nepodařilo upravit." } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubory se nepodařilo upravit." } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld souboru se nepodařilo upravit." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld souborů se nepodařilo upravit." } } } } }
      }
    },
    "Something went wrong. Please try again." : {
      "comment" : "Generic error message",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Něco se pokazilo. Zkuste to prosím znovu." } } }
    },
    "DropKeeper can't open its database" : {
      "comment" : "Fatal alert title at launch",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemůže otevřít svou databázi" } } }
    },
    "Quit DropKeeper and try again. Your files have not been touched." : {
      "comment" : "Fatal alert message at launch",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ukončete DropKeeper a zkuste to znovu. Vašich souborů se nic nedotklo." } } }
    }
  },
  "version" : "1.0"
}
