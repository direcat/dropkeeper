        "fr" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper ne peut pas ouvrir sa base de données" } }
      }
    },
    "Quit DropKeeper and try again. Your files have not been touched." : {
      "comment" : "Fatal alert message at launch",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ukončete DropKeeper a zkuste to znovu. Vašich souborů se nic nedotklo." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper beenden und erneut versuchen. Es wurden keine Dateien verändert." } },
