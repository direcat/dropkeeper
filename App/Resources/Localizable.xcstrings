    },
    "Automatically shows new downloads in the notch when the pointer is on the laptop screen." : {
      "comment" : "Settings help text under the prompt presentation picker",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Automaticky ukáže nová stažení ve výřezu, když je kurzor na displeji notebooku." } } }
    },
    "Quiet mode" : {
      "comment" : "Settings toggle",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tichý režim" } } }
    },
    "Don't open the prompt by itself. A dot on the menu bar icon shows waiting files." : {
      "comment" : "Settings: Quiet mode explanation",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Výzva se neotevře sama. Čekající soubory ukáže tečka na ikoně v menu baru." } } }
    },
    "Folders" : {
      "comment" : "Settings section title",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složky" } } }
    },
    "DropKeeper has no access to this folder." : {
      "comment" : "Settings: watched folder without file access",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemá k této složce přístup." } } }
    },
    "This folder is not available." : {
      "comment" : "Settings: watched folder that is missing or on an unmounted disk",
