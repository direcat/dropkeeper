{
  "sourceLanguage" : "en",
  "strings" : {
    "Same as %@" : {
      "comment" : "Prompt hint: the new file is identical to this existing file",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Stejný jako %@" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Identisch mit %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Igual que %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Identique à %@" } }
      }
    },
    "Delete duplicate" : {
      "comment" : "Prompt button: delete the new file that duplicates an existing one",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat duplikát" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Duplikat löschen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar duplicado" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer le doublon" } }
      }
    },
    "Extend by %@" : {
      "comment" : "Reminder bar button: push the deadline back by the timer length, e.g. Extend by 30 min",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Prodloužit o %@" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Um %@ verlängern" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ampliar %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Prolonger de %@" } }
      }
    },
    "Extend" : {
      "comment" : "Reminder bar button when the files have different timer lengths",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Prodloužit" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlängern" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ampliar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Prolonger" } }
      }
    },
    "Delete now" : {
      "comment" : "Reminder bar button: dispose of the files right away",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat hned" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Jetzt löschen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar ahora" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer maintenant" } }
      }
    },
    "Deleted in %@" : {
      "comment" : "Reminder bar subtitle with the time left, e.g. Deleted in 5 min",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazání za %@" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löschung in %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminará en %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suppression dans %@" } }
      }
    },
    "%@ — deleted in %@ (%@)" : {
      "comment" : "Rule notice: file name or file count, time until deletion, rule name",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "%@ — smazání za %@ (%@)" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ — Löschung in %@ (%@)" } },
