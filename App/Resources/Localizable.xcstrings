    },
    "Add stop" : {
      "comment" : "Settings button that adds a timeline stop",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přidat bod" } } }
    },
    "Apply default after" : {
      "comment" : "Settings picker: grace period before the default choice applies",
