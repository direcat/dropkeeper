    },
    "Actions" : {
      "comment" : "VoiceOver label of a pending list row's actions menu",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Akce" } } }
    },
    "Retry" : {
      "comment" : "Pending list action that retries a failed file",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zkusit znovu" } } }
    },
    "Change time" : {
      "comment" : "Pending list submenu that reschedules a file",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Změnit čas" } } }
    },
    "Show in Finder" : {
      "comment" : "Pending list action that reveals a file in Finder",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazit ve Finderu" } } }
