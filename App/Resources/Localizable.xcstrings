    },
    "That folder is inside, or contains, a folder that is already watched." : {
      "comment" : "Error when a new folder overlaps a watched one",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato složka leží ve sledované složce, nebo sledovanou složku obsahuje." } } }
    },
    "%lld files could not be updated." : {
      "comment" : "Error after a batch action where some files failed",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld file could not be updated." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld files could not be updated." } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubor se nepodařilo upravit." } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld soubory se nepodařilo upravit." } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld souboru se nepodařilo upravit." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld souborů se nepodařilo upravit." } } } } }
      }
    },
    "Something went wrong. Please try again." : {
      "comment" : "Generic error message",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Něco se pokazilo. Zkuste to prosím znovu." } } }
    },
    "DropKeeper can't start" : {
      "comment" : "Fatal alert title when the engine fails to start",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper se nepodařilo spustit" } } }
    },
    "Couldn't update the file. Please try again." : {
      "comment" : "Panel error after a failed prompt or list action",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo upravit. Zkuste to prosím znovu." } } }
    },
    "Couldn't put the file back from the Trash." : {
      "comment" : "Panel error after a failed Undo",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo vrátit z Koše." } } }
    },
    "Couldn't move the file to the Trash. Please try again later." : {
      "comment" : "Panel error after a failed Retry",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubor se nepodařilo přesunout do Koše. Zkuste to prosím později." } } }
    },
    "Couldn't watch Downloads" : {
      "comment" : "Onboarding alert title when adding Downloads fails",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složku Stažené nelze sledovat" } } }
    },
    "DropKeeper can't open its database" : {
      "comment" : "Fatal alert title at launch",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemůže otevřít svou databázi" } } }
    },
    "Quit DropKeeper and try again. Your files have not been touched." : {
      "comment" : "Fatal alert message at launch",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ukončete DropKeeper a zkuste to znovu. Vašich souborů se nic nedotklo." } } }
    },
    "Delete after" : {
      "comment" : "VoiceOver label of the timeline",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat po" } } }
    },
    "Kept" : {
      "comment" : "Shown above the Keep stop on the timeline",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ponecháno" } } }
    },
    "Keep" : {
      "comment" : "Last timeline stop: keep the file",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ponechat" } } }
    },
    "Keep it" : {
      "comment" : "Prompt button and VoiceOver value: keep the file",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ponechat" } } }
    },
    "Delete in %@, at %@" : {
      "comment" : "VoiceOver value of the timeline, e.g. Delete in 1 hour, at Today 16:40",
