      }
    },
    "* matches any characters and ? matches one. A plain word such as zip means *.zip." : {
      "comment" : "Caption under the ignored file pattern field",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "* nahradí libovolné znaky a ? jeden znak. Samotné slovo, například zip, znamená *.zip." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "* steht für beliebige Zeichen, ? für genau eins. Ein einfaches Wort wie zip bedeutet *.zip." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "* sustituye cualquier cantidad de caracteres y ? uno solo. Una palabra suelta, como zip, equivale a *.zip." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "* remplace n’importe quels caractères et ? un seul. Un simple mot comme zip équivaut à *.zip." } }
      }
    },
    "This pattern would match every file." : {
      "comment" : "Caption shown when a pattern consists only of wildcards",
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tento vzor by odpovídal všem souborům." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Muster würde auf jede Datei passen." } },
