    "Welcome to DropKeeper" : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vítá vás DropKeeper" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommen bei DropKeeper" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Te damos la bienvenida a DropKeeper" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Bienvenue dans DropKeeper" } }
      }
    },
    "Every new download gets an expiry. Pick 30 minutes, a day, or keep it. When time is up, DropKeeper moves the file to the Trash." : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Každé nové stažení dostane dobu platnosti. Vyberte 30 minut, den, nebo ho ponechte. Až čas vyprší, DropKeeper soubor přesune do Koše." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Jeder neue Download erhält ein Ablaufdatum: 30 Minuten, ein Tag oder Behalten. Ist die Zeit um, legt DropKeeper die Datei in den Papierkorb." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada descarga nueva recibe una fecha de caducidad. Elige 30 minutos, un día o conservarla. Al agotarse el tiempo, DropKeeper mueve el archivo a la Papelera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chaque nouveau téléchargement reçoit une date d’expiration : 30 minutes, un jour ou le conserver. Une fois le délai écoulé, DropKeeper met le fichier à la corbeille." } }
      }
    },
    "100 % offline, no analytics, no tracking, nothing leaves your computer." : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "100% offline, žádná analytika, žádné sledování, nic neopustí váš počítač." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "100 % offline, keine Analysedaten, kein Tracking, nichts verlässt den Computer." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "100 % sin conexión, sin analíticas, sin rastreo, nada sale de tu equipo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "100 % hors ligne, aucune analyse, aucun suivi, rien ne quitte votre ordinateur." } }
      }
    },
    "Allow access to Downloads" : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit přístup ke složce Stažené" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff auf Downloads erlauben" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Permitir acceso a Descargas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’accès à Téléchargements" } }
      }
    },
    "Downloads is watched" : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složka Stažené je sledovaná" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Ordner „Downloads“ wird überwacht" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se supervisa la carpeta Descargas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le dossier Téléchargements est surveillé" } }
      }
    },
    "DropKeeper has no access to Downloads. Allow it in System Settings → Privacy & Security → Files and Folders." : {
      "localizations" : {
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemá přístup ke složce Stažené. Povolte ho v Nastavení systému → Soukromí a zabezpečení → Soubory a složky." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper hat keinen Zugriff auf Downloads. Zugriff erlauben unter Systemeinstellungen → Datenschutz & Sicherheit → Dateien und Ordner." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper no tiene acceso a Descargas. Permítelo en Ajustes del Sistema → Privacidad y seguridad → Archivos y carpetas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper n’a pas accès à Téléchargements. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Fichiers et dossiers." } }
      }
    },
    "Open System Settings" : {
      "localizations" : {
