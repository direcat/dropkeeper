        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "Použít pro %lld nový soubor" } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "Použít pro všechny %lld nové soubory" } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "Použít pro všech %lld nového souboru" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "Použít pro všech %lld nových souborů" } } } } }
      }
    },
    "%lld new files" : {
      "comment" : "Prompt metadata: number of stacked new files",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld new file" } },
