          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld nové soubory" } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld nového souboru" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld nových souborů" } } } } }
      }
    },
    "Done" : {
      "comment" : "Prompt primary button",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Hotovo" } } }
    },
    "Close" : {
      "comment" : "Prompt close button (VoiceOver)",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zavřít" } } }
    },
    "%lld files" : {
      "comment" : "Notice title when several files were deleted at once",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld file" } },
