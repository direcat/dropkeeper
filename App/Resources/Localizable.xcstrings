          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld souborů naplánováno" } } } } }
      }
    },
    "Deleting in %@" : {
      "comment" : "VoiceOver value of the closed notch during the last-seconds countdown, e.g. Deleting in 0:07",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazání za %@" } } }
    },
    "No files scheduled" : {
      "comment" : "Empty state of the pending list",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nic není naplánováno" } } }
    },
    "Settings…" : {
      "comment" : "Pending list footer button that opens Settings",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nastavení…" } } }
    },
    "Quit DropKeeper" : {
      "comment" : "Pending list footer button that quits the app",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ukončit DropKeeper" } } }
    },
    "Waiting" : {
      "comment" : "Pending list status of a file waiting for a decision",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Čeká" } } }
    },
    "Couldn't move" : {
      "comment" : "Pending list status of a file that could not be moved to the Trash",
