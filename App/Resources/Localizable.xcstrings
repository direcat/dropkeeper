    },
    "%lld new files" : {
      "comment" : "Prompt metadata: number of stacked new files",
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld new file" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld new files" } } } } },
        "cs" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld nový soubor" } },
          "few" : { "stringUnit" : { "state" : "translated", "value" : "%lld nové soubory" } },
          "many" : { "stringUnit" : { "state" : "translated", "value" : "%lld nového souboru" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld nových souborů" } } } } }
      }
    },
    "Welcome to DropKeeper" : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vítá vás DropKeeper" } } }
    },
    "Every new download gets an expiry. Pick 30 minutes, a day, or keep it. When time is up, DropKeeper moves the file to the Trash." : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Každé nové stažení dostane dobu platnosti. Vyberte 30 minut, den, nebo ho ponechte. Až čas vyprší, DropKeeper soubor přesune do Koše." } } }
    },
    "100 % offline — no analytics, no tracking, nothing leaves your Mac." : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "100% offline – žádná analytika, žádné sledování, nic neopustí váš Mac." } } }
    },
    "Allow access to Downloads" : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit přístup ke složce Stažené" } } }
    },
    "Downloads is watched" : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složka Stažené je sledovaná" } } }
    },
    "DropKeeper has no access to Downloads. Allow it in System Settings → Privacy & Security → Files and Folders." : {
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "DropKeeper nemá přístup ke složce Stažené. Povolte ho v Nastavení systému → Soukromí a zabezpečení → Soubory a složky." } } }
    },
