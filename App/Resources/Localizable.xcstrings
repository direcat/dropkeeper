    },
    "If you don't choose" : {
      "comment" : "Settings picker: what happens when the user makes no choice",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Když nevyberete" } } }
    },
    "Delete after %@" : {
      "comment" : "Settings option: default choice, e.g. Delete after 1 hour",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat po %@" } } }
    },
    "Expired files" : {
      "comment" : "Settings picker: what happens to expired files",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Soubory po vypršení" } } }
    },
    "Move to Trash" : {
      "comment" : "Settings option: expired files go to the Trash",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přesunout do Koše" } } }
    },
    "Delete permanently" : {
      "comment" : "Settings option and confirm button: expired files are deleted permanently",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Trvale smazat" } } }
    },
    "Mark scheduled files with the “Temporary” Finder tag" : {
      "comment" : "Settings toggle",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Označit naplánované soubory štítkem Finderu „Temporary“" } } }
    },
    "Delete files permanently?" : {
      "comment" : "Confirmation title before switching to permanent deletion",
      "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Mazat soubory trvale?" } } }
    },
